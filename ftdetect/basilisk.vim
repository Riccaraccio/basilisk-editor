" Detect Basilisk C (http://basilisk.fr) sources among .c/.h files by content.
" Override per buffer with  :set filetype=basilisk  (or =c).

" GENERATED by tools/generate.py from spec/language.json -- do not edit
let s:basilisk_pattern = '\v^\s*%(event\s+\w+\s*\(|#\s*include\s*"%(navier-stokes|grid|two-phase|vof|saint-venant|layered|embed|tension|run|utils|output|view|fractions|axi|reduced|curvature|tracer|diffusion|poisson|green-naghdi|compressible|bcg|advection|atmosphere|momentum|contact|heights|common)[/.]|%(%(face|vertex|symmetric)\s+)?%(scalar|vector|tensor)\s+\*?\s*\w+\s*\[\]|%(foreach|foreach_\w+)\s*\()'
let s:basilisk_max_lines = 500
" END GENERATED

function! BasiliskDetect() abort
  if exists('g:basilisk_detect') && !g:basilisk_detect
    return
  endif
  for l:line in getline(1, min([line('$'), s:basilisk_max_lines]))
    if l:line =~# s:basilisk_pattern
      set filetype=basilisk
      return
    endif
  endfor
endfunction

autocmd BufRead,BufNewFile *.c,*.h call BasiliskDetect()
